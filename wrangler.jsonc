{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "propchamps",
  "compatibility_date": "2026-05-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // Pages go through worker/index.js first (it falls back to ASSETS.fetch), so the
    // canonical-origin 301s (www/http → https://propchamps.net) and the 307→301
    // conversion apply to them — by default matching static files skip the worker.
    // Static media/CSS/JS folders and root icons are served straight from assets.
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/logos/*",
      "!/data/*",
      "!/favicon.ico",
      "!/favicon-16x16.png",
      "!/favicon-32x32.png",
      "!/favicon-48x48.png",
      "!/apple-touch-icon.png",
      "!/icon-192.png",
      "!/icon-512.png",
      "!/og-image.jpg",
      "!/site.webmanifest"
    ]
  },
  "observability": { "enabled": true },
  "vars": {
    "DISCORD_CLIENT_ID": "1542538970154672201",
    "DISCORD_REDIRECT_URI": "https://propchamps.net/auth/discord/callback",
    "ADMIN_DISCORD_IDS": "790724483454861363",
    "HOST_DISCORD_IDS": "790724483454861363",
    "EMAIL_FROM": "PropChamps <deals@propchamps.net>",
    "DISCORD_INVITE_URL": "https://discord.com/invite/oasisalerts"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "propchamps-rewards",
      "database_id": "f7bbde9f-ad4f-4aac-b0c9-fcd3e4044732"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RECEIPTS",
      "bucket_name": "propchamps-receipts"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "87c6210d66b1403c82b4b95f7beae70f"
    }
  ]
}
