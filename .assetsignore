# Files/dirs listed here are NOT uploaded as public static assets.
# The assets directory is the repo root ("./"), so everything not needed by
# the public site must be excluded — especially source, config, VCS, and
# local/dev state. Gitignore-style syntax.

# source + build tooling (never needed by the browser)
worker
# tools/ holds build scripts (private) AND one public page — the drawdown
# calculator (/tools/prop-firm-drawdown-calculator) + its stylesheet. Ignore the
# folder's contents, then re-include only page/style files. Wrangler tests each
# file path with the gitignore-compatible `ignore` lib, so negation works here.
tools/*
!tools/*.html
!tools/*.css

# Cloudflare / project config (contains infra + admin IDs — not secret, but not public)
wrangler.jsonc

# version control (would otherwise expose the entire repo + history)
.git

# local dev / editor state
.wrangler
.claude
.gitignore
.assetsignore
.DS_Store

# docs + drafts not meant to be served
README.md
preview

# Rewards program — HIDDEN 2026-09-01 (prop firms said it breaks their terms).
# Kept in the repo for a possible future revival, but NOT served publicly; the
# worker also redirects these paths to home. To bring it back: remove these two
# lines and the redirect block in worker/index.js.
rewards
win.html
